    "lr": 0.01,
    "momentum": 0.0,
    "weight_decay": 0.0,
    "mu": 0.01,
    "server_lr": 1.0,
    "early_stop_target": null
  },
  "eval": {
    "test_every": 10,
    "batch_size": 256
  },
  "train": {
    "amp": "bf16",
    "out_dir": "/vol/runs/abl_lora",
    "save_model": true,
    "run_name": "fedavg-lora-r16_iid_s1"
  }
