{
  "seed": 1,
  "data": {
    "path": "/vol/data/prepared/kermany.pt",
    "synthetic": false
  },
  "partition": {
    "num_clients": 10,
    "scheme": "iid",
    "alpha": 0.5,
    "min_size": 20
  },
  "acquisition": {
    "severity": 0.0,
    "harmonize": false,
    "ref_images": 200,
    "eval_profiles": true
  },
  "model": {
    "name": "vit_small_patch16_224.augreg_in21k_ft_in1k",
    "pretrained": true,
    "peft": "lora",
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_targets": [
